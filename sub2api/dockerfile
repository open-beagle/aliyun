# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM node:24-alpine AS frontend
WORKDIR /src/frontend
RUN corepack enable && corepack prepare pnpm@9 --activate
COPY upstream/frontend/package.json upstream/frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,id=sub2api-pnpm,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY upstream/frontend/ ./
COPY upstream/docs/legal/ /src/docs/legal/
RUN pnpm run build

FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine AS backend
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.2.16-fix
ARG UPSTREAM_COMMIT=01842576b3d5c1e2545b5a99ad555d36e28ed306
ENV GOPROXY=https://proxy.golang.org,direct
WORKDIR /src/backend
RUN apk add --no-cache git ca-certificates
COPY upstream/backend/go.mod upstream/backend/go.sum ./
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod go mod download
COPY upstream/backend/ ./
COPY --from=frontend /src/backend/internal/web/dist ./internal/web/dist
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-gobuild,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -tags embed -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION} -X main.Commit=${UPSTREAM_COMMIT}+grok-tier -X main.BuildType=release" \
    -o /out/sub2api ./cmd/server

FROM weishaw/sub2api:0.2.16
ARG VERSION=0.2.16-fix
LABEL version=${VERSION}
ENV TZ=Asia/Shanghai TIMEZONE=Asia/Shanghai
COPY --from=backend --chown=sub2api:sub2api /out/sub2api /app/sub2api
